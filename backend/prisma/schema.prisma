generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  INBOX
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FocusStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  name                String
  currentFocusTaskId  String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  projects            Project[]
  tasks               Task[]
  notes               Note[]
  timeBlocks          TimeBlock[]
  focusSessions       FocusSession[]
  tags                Tag[]
  dailyReviews        DailyReview[]
  categories          Category[]
}

model Project {
  id          String        @id @default(uuid())
  userId      String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  icon        String        @default("folder")
  color       String        @default("#3A96D4")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories  Category[]
  tasks       Task[]
  notes       Note[]
  timeBlocks  TimeBlock[]

  @@index([userId, status])
}

model Category {
  id          String   @id @default(uuid())
  userId      String
  projectId   String
  name        String
  description String?
  icon        String   @default("folder")
  color       String   @default("#64748B")
  sortOrder   Int      @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
  notes       Note[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([userId, projectId])
}

model Task {
  id                String         @id @default(uuid())
  userId            String
  title             String
  description       String?
  projectId         String?
  categoryId        String?
  status            TaskStatus     @default(INBOX)
  priority          Priority       @default(MEDIUM)
  dueDate           String?
  dueTime           String?
  estimatedMinutes  Int?
  actualMinutes     Int?
  completedAt       DateTime?
  parentTaskId      String?
  snoozedUntil      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category          Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parent            Task?          @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks          Task[]         @relation("Subtasks")
  notes             Note[]
  timeBlocks        TimeBlock[]
  focusSessions     FocusSession[]
  tags              TaskTag[]

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, projectId])
  @@index([categoryId])
  @@index([parentTaskId])
}

model Note {
  id         String    @id @default(uuid())
  userId     String
  title      String
  content    String    @default("")
  projectId  String?
  categoryId String?
  taskId     String?
  tags       String[]  @default([])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, projectId])
  @@index([categoryId])
}

model TimeBlock {
  id        String   @id @default(uuid())
  userId    String
  title     String
  projectId String?
  taskId    String?
  date      String
  startTime String
  endTime   String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model FocusSession {
  id                String      @id @default(uuid())
  userId            String
  taskId            String
  startedAt         DateTime
  endedAt           DateTime?
  durationMinutes   Int         @default(0)
  accumulatedSeconds Int        @default(0)
  status            FocusStatus @default(RUNNING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  task              Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, startedAt])
}

model Tag {
  id     String    @id @default(uuid())
  userId String
  name   String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  TaskTag[]

  @@unique([userId, name])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model DailyReview {
  id             String   @id @default(uuid())
  userId         String
  date           String
  plannedTasks   Int      @default(0)
  completedTasks Int      @default(0)
  focusMinutes   Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
